    {
      "name": "21bd7324",
      "displayName": "Dominant Drivers",
      "queryLines": [
        "with dominant_driver as(\r\n",
        "\r\n",
        "    select \r\n",
        "            a.driver_name,\r\n",
        "            sum(a.number_participations) as race_starts,\r\n",
        "            sum(a.number_wins) as wins,\r\n",
        "            sum(a.number_podiums) as podiums,\r\n",
        "            sum(a.Total_points) as points,\r\n",
        "            sum(case when a.standing_position = 1 then 1 else 0 end) as total_championships\r\n",
        "          \r\n",
        "    from  driver_standings  a\r\n",
        "    group by a.driver_name\r\n",
        ")\r\n",
        "\r\n",
        "select \r\n",
        "    driver_name,\r\n",
        "    race_starts,\r\n",
        "    wins,\r\n",
        "    podiums,\r\n",
        "    points,\r\n",
        "    total_championships,\r\n",
        "    (total_championships*100)+(wins*10)+(podiums*3) as total_score\r\n",
        "\r\n",
        "from dominant_driver\r\n",
        "order by total_score desc\r\n",
        "limit 10;"
      ],
      "catalog": "formula1",
      "schema": "gold"
    }
  ],
